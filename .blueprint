models:
    Asociacion: { name: string, nif: 'string unique', razon_social: 'string unique', direccion: 'string unique', email: 'string unique', timestamps: timestamps }
    GestionaAsociacion: { id_user: 'foreign:users.id onDelete:cascade', id_asociacion: 'id foreign:asociaciones onDelete:cascade', primary: 'id_user, id_asociacion' }
    TelefonoAsociacion: { id_asociacion: 'id foreign:asociaciones onDelete:cascade', telefono: 'string unique', descripcion: 'text nullable' }
    PerteneceAsociacion: { id_user: 'foreign:users.id onDelete:cascade', id_asociacion: 'id foreign:asociaciones onDelete:cascade', estado: 'enum:pendiente,aceptado,rechazado', primary: 'id_user, id_asociacion' }
    Categoria: { nombre: 'string unique' }
    Producto: { id_asociacion: 'id foreign:asociaciones onDelete:cascade', nombre: string, descripcion: 'text nullable', precio: 'decimal(10,2)', stock: integer, foto: 'string nullable', id_categoria: 'id foreign:categorias nullable' }
    UsuarioGustaProducto: { id_user: 'foreign:users.id onDelete:cascade', id_producto: 'id foreign:productos onDelete:cascade', primary: 'id_user, id_producto' }
    Pedido: { id_user: 'foreign:users.id onDelete:restrict', fecha_pedido: datetime, total: 'decimal(10,2)', estado: 'enum:pendiente,pagado,enviado,cancelado' }
    PedidoContieneProducto: { id_pedido: 'id foreign:pedidos onDelete:cascade', id_producto: 'id foreign:productos onDelete:cascade', cantidad: integer, primary: 'id_pedido, id_producto' }
    Comentario: { id_user: 'foreign:users.id onDelete:null nullable', id_producto: 'id foreign:productos onDelete:cascade', texto: 'text nullable', valoracion: 'integer min:1 max:10', fecha: 'timestamp default:current' }
    UsuarioGustaComentario: { id_user: 'foreign:users.id onDelete:restrict', id_comentario: 'id foreign:comentarios onDelete:cascade', primary: 'id_user, id_comentario' }
    FormularioContacto: { id_user: 'foreign:users.id nullable', nombre: 'string nullable', email: string, mensaje: text, fecha_envio: 'timestamp default:current' }
    Association: { name: string, tax_id: 'string unique', business_name: 'string unique', address: 'string unique', email: 'string unique', timestamps: timestamps }
    ManagesAssociation: { user_id: 'foreign:users.id onDelete:cascade', association_id: 'id foreign:associations onDelete:cascade', primary: 'user_id, association_id' }
    AssociationPhone: { association_id: 'id foreign:associations onDelete:cascade', phone: 'string unique', description: 'text nullable' }
    MemberAssociation: { user_id: 'foreign:users.id onDelete:cascade', association_id: 'id foreign:associations onDelete:cascade', status: 'enum:pending,accepted,rejected', primary: 'user_id, association_id' }
    Category: { name: 'string unique' }
    Product: { association_id: 'id foreign:associations onDelete:cascade', name: string, description: 'text nullable', price: 'decimal(10,2)', stock: integer, image: 'string nullable', category_id: 'id foreign:categories nullable' }
    UserLikesProduct: { user_id: 'foreign:users.id onDelete:cascade', product_id: 'id foreign:products onDelete:cascade', primary: 'user_id, product_id' }
    Order: { user_id: 'foreign:users.id onDelete:restrict', order_date: datetime, total: 'decimal(10,2)', status: 'enum:pending,paid,shipped,cancelled' }
    OrderContainsProduct: { order_id: 'id foreign:orders onDelete:cascade', product_id: 'id foreign:products onDelete:cascade', quantity: integer, primary: 'order_id, product_id' }
    Comment: { user_id: 'foreign:users.id onDelete:null nullable', product_id: 'id foreign:products onDelete:cascade', content: 'text nullable', rating: 'integer min:1 max:10', date: 'timestamp default:current' }
    UserLikesComment: { user_id: 'foreign:users.id onDelete:restrict', comment_id: 'id foreign:comments onDelete:cascade', primary: 'user_id, comment_id' }
    ContactForm: { user_id: 'foreign:users.id nullable', name: 'string nullable', email: string, message: text, sent_at: 'timestamp default:current' }
